# Story Engine frontend configuration.
# Copy to .env.local to use. Every value here is optional — with no .env.local
# `next dev` runs entirely on MockApi and needs no backend.

# --- Mock vs live ---------------------------------------------------------- #
# The default is decided by the build, so forgetting this variable can never
# ship fabricated data:
#
#   unset + `next dev`             -> mock (hack on the UI with no backend)
#   unset + `next build`/`start`   -> LIVE FastAPI client
#   "true"                         -> mock, in any environment
#   "false"                        -> live, in any environment
#
# Whichever side wins is shown as a badge in the header of /casting and
# /timeline, so a viewer never has to guess which they are looking at. Setting
# this to "true" in a deployed build is legal but deliberately loud: the badge
# turns red and reads "MOCK DATA — NOT REAL".
#
# NEXT_PUBLIC_USE_MOCK_API=false

# Where /api/v1 lives. The default is relative so requests stay same-origin and
# next.config.ts proxies them to uvicorn (the backend serves no CORS headers).
# Only set an absolute URL once the API is same-origin or CORS-enabled.
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Upstream for that dev proxy. Server-side only; not inlined into the bundle.
# API_PROXY_TARGET=http://127.0.0.1:8000

# The demo routes hard-code the project id "demo". Set this to a real project
# id to point them at live data without editing any page.
# NEXT_PUBLIC_DEMO_PROJECT_ID=
