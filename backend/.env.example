# Story Engine — copy to .env and fill in. .env is gitignored; never commit real
# keys, and note that .dockerignore keeps .env out of container images too.
#
# app/config.py merges this file into the environment at import with
# override=False, so a real environment variable always wins over a line here.
# Nothing below is read at import time: leaving the whole file blank is safe and
# keeps the app on its in-memory, no-cloud defaults.

# =========================================================================
# Google Cloud — the only AI provider this build uses
# =========================================================================
# Provider selection is credential-based, not name-based: a configured project
# picks the Google adapters for TTS, video and LLM, and there is no keyless
# fallback. Unset, those dependencies raise instead of silently degrading.
GOOGLE_CLOUD_PROJECT=

# Any Application Default Credentials source works: a service-account key path
# here, `gcloud auth application-default login` locally, or the metadata server
# on Cloud Run — where you attach a service account instead and leave this blank.
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex region. Veo is region-pinned; us-central1 is the safe default.
GOOGLE_CLOUD_LOCATION=us-central1

# Forced to "1" by the ADK seam so google-genai talks to Vertex rather than the
# public Gemini API. Listed for visibility; you should not need to set it.
GOOGLE_GENAI_USE_VERTEXAI=

# Model overrides. Defaults live in the adapters; set these only to pin.
GOOGLE_GEMINI_MODEL=
GOOGLE_GEMINI_LOCATION=
GOOGLE_TTS_MODEL=
GOOGLE_TTS_LANGUAGE_CODE=
GOOGLE_VEO_MODEL=
STORY_ENGINE_AGENT_MODEL=

# =========================================================================
# Media storage (app/storage/) — durable renders
# =========================================================================
# Without a bucket, rendered audio and video stay in process memory and die with
# the container. Set this for any real deployment.
GCS_BUCKET=
GCS_PREFIX=

# Veo can write straight to GCS instead of returning bytes. Set to a gs:// URI
# to use that path for video renders.
GOOGLE_VEO_STORAGE_URI=

# Serving URLs. A public base URL is used verbatim; otherwise URLs are signed,
# which on Cloud Run needs a service account with the token-creator role.
GCS_PUBLIC_BASE_URL=
GCS_SIGNER_SERVICE_ACCOUNT=

# =========================================================================
# ClickHouse analytics (app/analytics/) — reached via the MCP server
# =========================================================================
# Off by default. The test suite forces this to 0 regardless, because this file
# is merged into the environment on import and a live cluster would otherwise
# collect test rows.
STORY_ENGINE_ANALYTICS_ENABLED=

# Read verbatim by the official mcp-clickhouse server, which the stdio
# transport launches as a child process. Names mirror that server's own 1:1.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_SECURE=
CLICKHOUSE_VERIFY=
CLICKHOUSE_CONNECT_TIMEOUT=
CLICKHOUSE_ROLE=

# Transport: "stdio" (default, spawns the server here) or "http" (attach to an
# already-running endpoint, which then needs STORY_ENGINE_MCP_URL).
STORY_ENGINE_MCP_TRANSPORT=
STORY_ENGINE_MCP_URL=
STORY_ENGINE_MCP_AUTH_TOKEN=

# Override how the stdio server is launched. Defaults to running
# `python -m mcp_clickhouse.main` with this interpreter.
STORY_ENGINE_MCP_COMMAND=
STORY_ENGINE_MCP_ARGS=
STORY_ENGINE_MCP_TOOL=

# Write batching. Events buffer in memory and drain on a background task, so on
# Cloud Run keep CPU always-allocated or the drain stalls between requests.
STORY_ENGINE_CLICKHOUSE_DATABASE=
STORY_ENGINE_ANALYTICS_BATCH_SIZE=
STORY_ENGINE_ANALYTICS_BUFFER_MAX=
STORY_ENGINE_ANALYTICS_FLUSH_INTERVAL_S=

# =========================================================================
# App
# =========================================================================
# Signs auth tokens. Defaults to a known dev value — set this in any deployment.
STORY_ENGINE_SECRET=

# =========================================================================
# Persistence (app/db/session.py, app/api/deps.py)
# =========================================================================
# Selects between InMemoryRepository (default — no state survives a restart)
# and SqlAlchemyRepository (durable, backed by the store_* tables in
# alembic/versions/0002_api_record_store.py).

# Full connection string, e.g. postgresql://user:pass@host:5432/story_engine.
# "postgres://" and "postgresql+psycopg2://" are accepted and normalized onto
# the psycopg 3 driver. Takes priority over the Cloud SQL vars below.
DATABASE_URL=

# Cloud Run + Cloud SQL alternative to DATABASE_URL: set these instead of a
# full URL and the app assembles a unix-socket connection string itself.
# INSTANCE_UNIX_SOCKET is the full mounted path; CLOUD_SQL_CONNECTION_NAME is
# the bare "project:region:instance" form, expanded to /cloudsql/<name>.
INSTANCE_UNIX_SOCKET=
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASS=
DB_NAME=

# Force the in-memory repository even if a database is configured above.
# Exists because .env is merged into the environment on import, so a developer
# with a real DATABASE_URL here would otherwise point every local run at
# Postgres by accident. Set to "memory" to opt out.
STORY_ENGINE_REPO=

# Belt-and-braces schema creation for a deployment that has not run
# `alembic upgrade head` yet. The container entrypoint runs alembic for you
# when a database is configured, so this is a fallback, not the supported path.
STORY_ENGINE_DB_CREATE_ALL=
