# Story Engine — copy to .env and fill in. .env is gitignored; never commit real keys.
# Whichever key is set selects that TTS provider automatically (ElevenLabs > Azure > Edge).

# ElevenLabs TTS. Setting the key selects ElevenLabs. Voice id is optional
# (defaults to Rachel, 21m00Tcm4TlvDq8ikWAM); find ids via GET /v1/voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Azure Speech (neural TTS). Both are required to select Azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Runway (image/text -> video renderer). Get a secret key (starts with "key_")
# from https://dev.runwayml.com. Used by the video adapter; never required to
# import the app or run tests.
RUNWAY_API_KEY=

# App secret for signing auth tokens.
STORY_ENGINE_SECRET=

# --- Persistence (app/db/session.py, app/api/deps.py) ----------------------
# Selects between InMemoryRepository (default - no state survives a restart)
# and SqlAlchemyRepository (durable, backed by the store_* tables in
# alembic/versions/0002_api_record_store.py). Nothing here is read at import
# time, so leaving it all blank is always safe and keeps the app on the
# in-memory repository every test runs against.

# Full connection string, e.g. postgresql://user:pass@host:5432/story_engine.
# "postgres://" and "postgresql+psycopg2://" are accepted and normalized onto
# the psycopg 3 driver. Takes priority over the Cloud SQL vars below. Leave
# unset for local dev / tests.
DATABASE_URL=

# Cloud Run + Cloud SQL alternative to DATABASE_URL: set these instead of a
# full URL and the app assembles a unix-socket connection string itself.
# INSTANCE_UNIX_SOCKET is the full mounted path (Google's own samples use
# this name); CLOUD_SQL_CONNECTION_NAME is the bare "project:region:instance"
# form, which the app expands to /cloudsql/<name>. Set one or the other, plus
# DB_USER and DB_NAME (DB_PASS only if the instance requires a password).
INSTANCE_UNIX_SOCKET=
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASS=
DB_NAME=

# Force the in-memory repository even if DATABASE_URL or the Cloud SQL vars
# above are set. Exists because .env is merged into the environment on
# import, so a developer with a real DATABASE_URL in .env would otherwise
# point every local run at Postgres by accident. Set to "memory" to opt out.
STORY_ENGINE_REPO=

# Belt-and-braces schema creation for a deployment that has not run
# `alembic upgrade head` yet: creates the store_* tables directly from the
# ORM models if they don't already exist. Alembic is the supported path;
# this is an opt-in fallback, not a replacement. Set to "1"/"true"/"yes".
STORY_ENGINE_DB_CREATE_ALL=
