# Copy to .env and fill in. Never commit .env — provider keys stay out of source.
# Real keys are only needed for live renders; the entire test suite runs on fakes.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/story_engine
REDIS_URL=redis://localhost:6379/0

# Object storage (S3 or Cloudflare R2)
S3_ENDPOINT_URL=
S3_BUCKET=story-engine-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Providers — set hard spend caps on every provider dashboard as well (HANDOFF risk #5)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FLUX_API_KEY=

# Per-project default cost cap, cents (governor enforces before enqueue)
DEFAULT_COST_CAP_CENTS=15000
